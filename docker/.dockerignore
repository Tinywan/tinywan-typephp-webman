build/webman-server
build/webman-server.exe
build/*.exp
build/*.lib

# 运行时临时文件
runtime
temp_*.log
*.log

# Docker 自身文件
docker/Dockerfile.*
docker-compose*.yml

# 其他
node_modules
.DS_Store
Thumbs.db
